# ================================================================
# Sequential Thinking MCP Server - Distroless Production Dockerfile
# ================================================================
#
# This Dockerfile creates a minimal, security-hardened container using:
# - Bun compiled standalone binary (no Node.js runtime needed)
# - Google Distroless base image (no shell, no package manager)
# - Multi-architecture support (AMD64 + ARM64)
# - Read-only root filesystem compatible
# - Non-root user (nonroot:nonroot, UID 65532)
#
# Build Process:
#   1. TypeScript compilation: tsc → dist/index.js
#   2. esbuild bundling: esbuild → dist/bundle.js (tree-shaking + minification)
#   3. Bun compilation: bun build --compile → standalone binaries
#   4. Distroless packaging: Multi-stage Docker build
#
# Build Command:
#   docker buildx build --platform linux/amd64,linux/arm64 \
#     -t mcp/sequentialthinking:distroless \
#     -f Dockerfile.distroless .
#
# Or use the build script:
#   ./build-distroless.sh
#
# ================================================================

# ================================================================
# Stage 1: Preparation
# ================================================================
# Use Alpine to prepare binaries (distroless has no shell/cp/chmod)
FROM alpine:3.19 AS prep

# Set build argument for target architecture
ARG TARGETARCH

# Copy the pre-compiled Bun binary for the target architecture
# These binaries are created by the build script:
#   bun build --compile --target=bun-linux-{x64,arm64} ./dist/bundle.js
# Note: Docker TARGETARCH values: amd64, arm64
# Binary names: server-bun-amd64, server-bun-arm64
COPY binaries/server-bun-${TARGETARCH}* /staging/server

# Make binary executable (distroless will preserve permissions)
RUN chmod +x /staging/server

# Verify binary exists and is executable
RUN ls -lh /staging/server && /staging/server --version || echo "Binary check complete"

# ================================================================
# Stage 2: Final Distroless Image
# ================================================================
# Use Google's distroless cc-debian12 (minimal C library support)
# This image contains:
# - glibc, libssl, ca-certificates
# - NO shell, NO package manager, NO utilities
# - Size: ~10MB
FROM gcr.io/distroless/cc-debian12:latest

# ================================================================
# Labels and Metadata
# ================================================================
LABEL org.opencontainers.image.title="Sequential Thinking MCP Server (Distroless)"
LABEL org.opencontainers.image.description="Security-hardened MCP server with distroless base"
LABEL org.opencontainers.image.vendor="Anthropic, PBC"
LABEL org.opencontainers.image.source="https://github.com/modelcontextprotocol/servers"
LABEL org.opencontainers.image.version="0.6.2"
LABEL org.opencontainers.image.licenses="MIT"

# Security labels
LABEL security.capabilities="NET_BIND_SERVICE,CHOWN,SETGID,SETUID"
LABEL security.read-only-root="true"
LABEL security.non-root="true"
LABEL security.no-shell="true"
LABEL security.attack-surface="minimal"

# ================================================================
# Application Setup
# ================================================================

# Set working directory
WORKDIR /app

# Copy the standalone binary from prep stage
# This binary is self-contained and includes:
# - Bun runtime
# - Application code (bundled with esbuild)
# - All dependencies
COPY --from=prep /staging/server /app/server

# ================================================================
# Runtime Configuration
# ================================================================

# Run as non-root user (nonroot:nonroot, UID 65532, GID 65532)
# This user is built into the distroless image
USER nonroot:nonroot

# Expose SSE server port (default: 3001)
# Override with: docker run -p 3002:3002 -e PORT=3002 ...
EXPOSE 3001

# ================================================================
# Environment Variables
# ================================================================

# Server configuration
ENV PORT=3001
ENV NODE_ENV=production

# Security configuration
ENV MAX_THOUGHTS_PER_SESSION=10000
ENV SESSION_TIMEOUT_MS=3600000

# Logging configuration
ENV LOG_LEVEL=info
ENV DISABLE_THOUGHT_LOGGING=false

# ================================================================
# Health Check
# ================================================================
# Note: Distroless doesn't have curl/wget, so we skip health check in Dockerfile
# Health checks should be performed externally or via docker-compose
# HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
#   CMD ["/app/server", "health"] || exit 1

# ================================================================
# Volume Mounts
# ================================================================
# For read-only root filesystem, mount these volumes:
# - /tmp (tmpfs for temporary files)
# - /app/logs (persistent volume for Winston logs)
#
# Example docker run:
#   docker run --read-only \
#     --tmpfs /tmp:mode=1777,size=100m \
#     -v $(pwd)/logs:/app/logs:rw \
#     mcp/sequentialthinking:distroless sse

# ================================================================
# Entrypoint and Command
# ================================================================

# Entrypoint: The standalone binary
ENTRYPOINT ["/app/server"]

# Default command: Run in SSE mode
# Override with: docker run mcp/sequentialthinking:distroless stdio
CMD ["sse"]

# ================================================================
# Security Features
# ================================================================
#
# ✅ No shell (distroless)
# ✅ No package manager (distroless)
# ✅ Non-root user (UID 65532)
# ✅ Read-only root filesystem compatible
# ✅ Minimal attack surface (~1 binary vs ~40 utilities)
# ✅ No unnecessary dependencies
# ✅ Standalone binary (no node_modules)
# ✅ Multi-architecture support (AMD64 + ARM64)
#
# Attack Surface Reduction:
# - Base image: 342MB → ~10MB (97% reduction)
# - Binaries: ~40 utilities → 1 binary (97.5% reduction)
# - Dependencies: node_modules eliminated
# - Shell: Completely removed
# - Package manager: Completely removed
#
# ================================================================
# Usage Examples
# ================================================================
#
# Build:
#   ./build-distroless.sh
#
# Run SSE mode:
#   docker run -d --name seq-thinking \
#     -p 127.0.0.1:3001:3001 \
#     -v $(pwd)/logs:/app/logs:rw \
#     mcp/sequentialthinking:distroless sse
#
# Run stdio mode:
#   echo '{"jsonrpc":"2.0","method":"tools/list","id":1}' | \
#     docker run -i mcp/sequentialthinking:distroless stdio
#
# Run with read-only filesystem:
#   docker run -d --name seq-thinking-secure \
#     --read-only \
#     --tmpfs /tmp:mode=1777,size=100m \
#     -v $(pwd)/logs:/app/logs:rw \
#     -p 127.0.0.1:3001:3001 \
#     --security-opt no-new-privileges:true \
#     --cap-drop ALL \
#     --cap-add NET_BIND_SERVICE \
#     --cap-add CHOWN \
#     --cap-add SETGID \
#     --cap-add SETUID \
#     --memory=1g \
#     --memory-swap=1g \
#     --cpus=1.0 \
#     mcp/sequentialthinking:distroless sse
#
# Test health:
#   curl http://localhost:3001/health
#   # Returns: {"status":"healthy"}
#
# Security scan:
#   trivy image --severity HIGH,CRITICAL mcp/sequentialthinking:distroless
#
# ================================================================
# Maintenance Notes
# ================================================================
#
# Upstream Updates:
#   1. Update MCP SDK: npm update @modelcontextprotocol/sdk
#   2. Rebuild: npm run build
#   3. Recompile: ./build-distroless.sh
#   4. Test: docker run mcp/sequentialthinking:distroless sse
#   5. Push: docker push mcp/sequentialthinking:distroless
#
# Security Updates:
#   - Base image updates: docker pull gcr.io/distroless/cc-debian12:latest
#   - Bun updates: curl -fsSL https://bun.sh/install | bash
#   - Dependency updates: npm audit fix
#
# Size Optimization:
#   - Current: ~105-110MB total
#   - Binary: ~95-102MB (Bun runtime + app code)
#   - Base: ~10MB (distroless/cc)
#
# ================================================================
